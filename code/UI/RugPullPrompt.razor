@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Linq;

@namespace GoblinChain.UI
@inherits PanelComponent

<!--
	Rug Pull Prompt — Appears at start of Chaos phase for token creators.
	The defining moment: Rug, Pivot, or Hold.
-->

<root class="rug-root @(IsVisible ? "visible" : "hidden")">
	@if ( IsVisible && MyToken is not null )
	{
		<div class="rug-frame">
			<div class="rug-title">DECISION TIME</div>
			<div class="token-info">
				<span class="token-name">$@MyToken.Value.Ticker</span>
				<span class="token-price">@MyToken.Value.Price.ToString("F3") GBC</span>
				<span class="token-pool">Pool: @MyToken.Value.PooledValue.ToString("N0") GBC</span>
			</div>

			<div class="timer-bar">
				<div class="timer-fill" style="width: @((TimerPercent * 100).ToString("F0"))%"></div>
				<span class="timer-text">@TimeRemaining.ToString("F0")s</span>
			</div>

			<div class="choices">
				<!-- RUG PULL -->
				<div class="choice rug" onclick="@DoRug">
					<div class="choice-icon">💀</div>
					<div class="choice-title">RUG PULL</div>
					<div class="choice-desc">Cash out @MyToken.Value.PooledValue.ToString("N0") GBC. Token crashes to 0. All holders get wrecked.</div>
					<div class="choice-warn">Reputation: -30%  |  SEC Heat: +40</div>
				</div>

				<!-- PIVOT -->
				<div class="choice pivot" onclick="@DoPivot">
					<div class="choice-icon">🔄</div>
					<div class="choice-title">PIVOT</div>
					<div class="choice-desc">Rebrand the token. Costs 100 GBC. Keeps holders. Builds reputation.</div>
					<div class="choice-good">Reputation: +10%  |  Quality: +10</div>
				</div>

				<!-- HOLD -->
				<div class="choice hold" onclick="@DoHold">
					<div class="choice-icon">💎</div>
					<div class="choice-title">DIAMOND HANDS</div>
					<div class="choice-desc">Do nothing. Let the market decide. Neutral reputation.</div>
					<div class="choice-neutral">The safe play. Boring, but honest.</div>
				</div>
			</div>
		</div>
	}
</root>

@code
{
	public bool IsVisible { get; set; } = false;
	public float TimeRemaining { get; set; } = 15f;
	public float TimerPercent => TimeRemaining / 15f;
	public Guid MyTokenId { get; set; } = Guid.Empty;

	public TokenData? MyToken => TokenSystem.Instance?.GetToken( MyTokenId );

	/// <summary>
	/// Called by GameStateManager when Chaos phase starts.
	/// </summary>
	public void ShowForToken( Guid tokenId )
	{
		MyTokenId = tokenId;
		TimeRemaining = 15f;
		IsVisible = true;
	}

	protected override void OnUpdate()
	{
		if ( !IsVisible ) return;

		TimeRemaining -= Time.Delta;
		if ( TimeRemaining <= 0f )
		{
			// Auto-hold
			IsVisible = false;
		}
	}

	private void DoRug()
	{
		TokenSystem.Instance?.RequestRugPull( MyTokenId );
		IsVisible = false;
	}

	// The classic post-scandal rebrand playbook, in ascending order of desperation
	private static readonly string[] PivotSuffixes =
	{
		" 2.0", " V2 (Audited)", " Classic", " Pro", " AI", " DAO",
		" (Real)", " Reborn", " Finance", " Green", " Trust Edition",
	};

	private void DoPivot()
	{
		var token = MyToken;
		if ( token is not null )
		{
			var suffix = PivotSuffixes[new System.Random().Next( PivotSuffixes.Length )];
			TokenSystem.Instance?.RequestPivot( MyTokenId, token.Value.Name + suffix, token.Value.Ticker );
		}
		IsVisible = false;
	}

	private void DoHold()
	{
		IsVisible = false;
	}
}

<style>
	.rug-root { position: absolute; left: 50%; top: 50%; transform: translateXY(-50%, -50%); pointer-events: all; }
	.rug-root.hidden { display: none; }

	.rug-frame {
		width: 600px;
		background-color: rgba(20, 0, 0, 0.95);
		border: 2px solid #ff4444;
		border-radius: 12px;
		padding: 24px;
		font-family: Consolas, monospace;
		color: #ffffff;
	}

	.rug-title {
		font-size: 24px; font-weight: bold; text-align: center;
		color: #ff4444; margin-bottom: 12px;
	}

	.token-info {
		display: flex; justify-content: center; gap: 20px;
		padding: 8px; margin-bottom: 12px; font-size: 14px;
	}
	.token-name { color: #ffaa00; font-weight: bold; font-size: 18px; }
	.token-price { color: #00ff41; }
	.token-pool { color: #ff8800; }

	.timer-bar {
		height: 24px; background: rgba(255, 255, 255, 0.1); border-radius: 4px;
		margin-bottom: 16px; position: relative; overflow: hidden;
	}
	.timer-fill {
		height: 100%; background: linear-gradient(90deg, #ff4444, #ffaa00);
		transition: width 0.5s linear;
	}
	.timer-text {
		position: absolute; top: 50%; left: 50%; transform: translateXY(-50%, -50%);
		font-weight: bold; font-size: 12px;
	}

	.choices { display: flex; gap: 12px; }

	.choice {
		flex: 1; padding: 16px; border-radius: 8px; cursor: pointer;
		text-align: center; transition: all 0.2s;
	}
	.choice:hover { transform: scale(1.03); }

	.choice.rug { border: 2px solid #ff4444; background: rgba(255, 0, 0, 0.1); }
	.choice.rug:hover { background: rgba(255, 0, 0, 0.3); }
	.choice.pivot { border: 2px solid #ffaa00; background: rgba(255, 170, 0, 0.1); }
	.choice.pivot:hover { background: rgba(255, 170, 0, 0.3); }
	.choice.hold { border: 2px solid #00ff41; background: rgba(0, 255, 65, 0.1); }
	.choice.hold:hover { background: rgba(0, 255, 65, 0.3); }

	.choice-icon { font-size: 32px; margin-bottom: 8px; }
	.choice-title { font-weight: bold; font-size: 14px; margin-bottom: 6px; }
	.choice-desc { font-size: 11px; opacity: 0.8; margin-bottom: 6px; line-height: 1.3; }
	.choice-warn { font-size: 10px; color: #ff4444; }
	.choice-good { font-size: 10px; color: #00ff41; }
	.choice-neutral { font-size: 10px; color: #888888; }
</style>
