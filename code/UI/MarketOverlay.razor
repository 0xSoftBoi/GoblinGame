@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Linq;

@namespace GoblinChain.UI
@inherits PanelComponent

<root class="market-overlay @(IsOpen ? "open" : "closed")">

	<div class="mo-panel">

		<!-- Header -->
		<div class="mo-header">
			<span class="mo-title">MARKET</span>
			@if ( _wallet is not null )
			{
				<span class="mo-balance">@_wallet.GoblinCoin.ToString("N0") GBC</span>
			}
			<button class="mo-close" onclick="@Close">✕</button>
		</div>

		<!-- Token rows -->
		<div class="mo-list">
			@if ( _rows.Count == 0 )
			{
				<div class="mo-empty">No active tokens yet</div>
			}
			@foreach ( var row in _rows )
			{
				<div class="mo-row">
					<div class="mo-info">
						<span class="mo-sym @(row.Change >= 0 ? "up" : "down")">$@row.Symbol</span>
						<span class="mo-price">@row.Price.ToString("F3")</span>
						<span class="mo-chg @(row.Change >= 0 ? "up" : "down")">@(row.Change >= 0 ? "▲" : "▼")@MathF.Abs(row.Change).ToString("F1")%</span>
					</div>
					<div class="mo-holdings @(row.HeldValue > 0 ? "has-holdings" : "")">
						@if ( row.Held > 0 )
						{
							<span>@row.Held.ToString("N0") units · @row.HeldValue.ToString("N1") GBC</span>
						}
						else
						{
							<span class="mo-none">—</span>
						}
					</div>
					<div class="mo-actions">
						<!-- Buy -->
						<button class="mo-btn buy" onclick="@(() => Buy(row.TokenId, 10f))">+10</button>
						<button class="mo-btn buy" onclick="@(() => Buy(row.TokenId, 50f))">+50</button>
						<button class="mo-btn buy" onclick="@(() => Buy(row.TokenId, 100f))">+100</button>
						<!-- Sell -->
						@if ( row.Held > 0 )
						{
							<button class="mo-btn sell" onclick="@(() => SellHalf(row.TokenId, row.Held))">½</button>
							<button class="mo-btn sell all" onclick="@(() => SellAll(row.TokenId, row.Held))">ALL</button>
						}
					</div>
				</div>
			}
		</div>

		<!-- Footer hint -->
		<div class="mo-hint">M to close · Buy cost in GBC · Sell returns GBC at market price</div>

	</div>

</root>

<style>
.market-overlay {
	position: absolute;
	top: 50%;
	left: 50%;
	transform: translate(-50%, -50%);
	pointer-events: all;
}
.market-overlay.closed { display: none; }

.mo-panel {
	width: 540px;
	background: rgba(2, 5, 15, 0.97);
	border: 1px solid #ffcc00;
	border-radius: 6px;
	font-family: 'Consolas', monospace;
	color: #ccc;
	overflow: hidden;
}

.mo-header {
	display: flex;
	align-items: center;
	gap: 10px;
	padding: 10px 16px;
	border-bottom: 1px solid #222;
	background: rgba(255, 204, 0, 0.04);
}
.mo-title {
	font-size: 13px;
	font-weight: bold;
	letter-spacing: 4px;
	color: #ffcc00;
	flex: 1;
}
.mo-balance {
	font-size: 12px;
	color: #ffcc00;
	opacity: 0.7;
}
.mo-close {
	color: #555;
	font-size: 16px;
	cursor: pointer;
	background: none;
	border: none;
	margin-left: 4px;
}
.mo-close:hover { color: #ff4444; }

.mo-list {
	max-height: 380px;
	overflow-y: auto;
	padding: 4px 0;
}

.mo-empty {
	text-align: center;
	color: #333;
	padding: 30px;
	font-size: 12px;
}

.mo-row {
	display: flex;
	flex-direction: column;
	gap: 4px;
	padding: 8px 16px;
	border-bottom: 1px solid rgba(255,255,255,0.04);
}
.mo-row:hover { background: rgba(255, 204, 0, 0.03); }

.mo-info {
	display: flex;
	align-items: center;
	gap: 10px;
}
.mo-sym {
	font-size: 14px;
	font-weight: bold;
	min-width: 60px;
}
.mo-sym.up { color: #00ff88; }
.mo-sym.down { color: #ff4444; }

.mo-price {
	font-size: 14px;
	color: #ccc;
	min-width: 70px;
}
.mo-chg {
	font-size: 11px;
	min-width: 55px;
}
.mo-chg.up { color: #00ff88; }
.mo-chg.down { color: #ff4444; }

.mo-holdings {
	font-size: 10px;
	color: #444;
	letter-spacing: 0.5px;
}
.mo-holdings.has-holdings { color: #888; }
.mo-none { opacity: 0.4; }

.mo-actions {
	display: flex;
	gap: 5px;
	flex-wrap: wrap;
}

.mo-btn {
	padding: 4px 10px;
	font-size: 10px;
	letter-spacing: 1px;
	border-radius: 3px;
	cursor: pointer;
	font-family: 'Consolas', monospace;
	font-weight: bold;
}
.mo-btn.buy {
	background: rgba(0, 255, 136, 0.08);
	color: #00ff88;
	border: 1px solid rgba(0, 255, 136, 0.3);
}
.mo-btn.buy:hover { background: rgba(0, 255, 136, 0.2); }
.mo-btn.sell {
	background: rgba(255, 68, 68, 0.08);
	color: #ff4444;
	border: 1px solid rgba(255, 68, 68, 0.3);
}
.mo-btn.sell:hover { background: rgba(255, 68, 68, 0.2); }
.mo-btn.sell.all {
	background: rgba(255, 68, 68, 0.14);
	border-color: rgba(255, 68, 68, 0.5);
}

.mo-hint {
	text-align: center;
	padding: 8px;
	font-size: 9px;
	color: #333;
	letter-spacing: 1px;
	border-top: 1px solid #111;
}
</style>

@code
{
	private record TokenRow(
		Guid TokenId, string Symbol, float Price, float Change,
		float Held, float HeldValue );

	public bool IsOpen { get; set; } = false;

	private CryptoWallet _wallet;
	private List<TokenRow> _rows = new();

	public void Toggle()
	{
		IsOpen = !IsOpen;
		Mouse.Visible = IsOpen;
	}

	public void Close()
	{
		IsOpen = false;
		Mouse.Visible = false;
	}

	protected override void OnUpdate()
	{
		// (Toggling is handled by PlayerInput's OpenMarket handler — a second
		// listener here would fire the same frame and cancel it out.)
		if ( !IsOpen ) return;

		var ts = TokenSystem.Instance;
		if ( ts is null ) return;

		var local = GoblinPlayer.All.FirstOrDefault( p => !p.IsProxy );
		_wallet = local?.Components.Get<CryptoWallet>();

		_rows = ts.GetActiveTokensSorted()
			.Where( t => !t.IsRugged )
			.Select( t =>
			{
				float held = _wallet?.GetTokenHolding( t.Id ) ?? 0f;
				var history = ts.GetPriceHistory( t.Id );
				float change = history.Count >= 2
					? ((t.Price - history[0]) / history[0]) * 100f
					: 0f;
				return new TokenRow( t.Id, t.Ticker, t.Price, change, held, held * t.Price );
			} )
			.ToList();
	}

	private void Buy( Guid tokenId, float gbcAmount )
	{
		TokenSystem.Instance?.RequestBuyToken( tokenId, gbcAmount );
	}

	private void SellHalf( Guid tokenId, float held )
	{
		float amount = MathF.Max( 1f, MathF.Floor( held * 0.5f ) );
		TokenSystem.Instance?.RequestSellToken( tokenId, amount );
	}

	private void SellAll( Guid tokenId, float held )
	{
		TokenSystem.Instance?.RequestSellToken( tokenId, held );
	}
}
