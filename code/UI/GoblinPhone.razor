@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Linq;

@namespace GoblinChain.UI
@inherits PanelComponent

<!--
	GoblinPhone — The in-game social media interface.
	Toggled by pressing T. Shows GoblinTwitter feed, trending tokens,
	and post composer. The soul of the game.
-->

<root class="phone-root @(IsOpen ? "open" : "closed")">

	@if ( IsOpen )
	{
		<div class="phone-frame">
			<!-- Tab bar -->
			<div class="phone-tabs">
				<div class="tab @(CurrentTab == "feed" ? "active" : "")" onclick="@(() => CurrentTab = "feed")">FEED</div>
				<div class="tab @(CurrentTab == "trending" ? "active" : "")" onclick="@(() => CurrentTab = "trending")">TRENDING</div>
				<div class="tab @(CurrentTab == "compose" ? "active" : "")" onclick="@(() => CurrentTab = "compose")">POST</div>
				<div class="tab @(CurrentTab == "portfolio" ? "active" : "")" onclick="@(() => CurrentTab = "portfolio")">BAGS</div>
				<div class="tab @(CurrentTab == "market" ? "active" : "")" onclick="@(() => CurrentTab = "market")">DEGEN</div>
			</div>

			<!-- Content area -->
			<div class="phone-content">

				@if ( CurrentTab == "feed" )
				{
					@RenderFeed()
				}
				else if ( CurrentTab == "trending" )
				{
					@RenderTrending()
				}
				else if ( CurrentTab == "compose" )
				{
					@RenderComposer()
				}
				else if ( CurrentTab == "portfolio" )
				{
					@RenderPortfolio()
				}
				else if ( CurrentTab == "market" )
				{
					@RenderMarket()
				}

			</div>

			<!-- Close hint -->
			<div class="phone-hint">Press T to close</div>
		</div>
	}

</root>

@code
{
	public bool IsOpen { get; set; } = false;
	public string CurrentTab { get; set; } = "feed";

	// Composer state
	private int _openerIdx = 0;
	private int _claimIdx = 0;
	private int _proofIdx = 0;
	private int _ctaIdx = 0;
	private string _customText = "";
	private Guid _selectedTokenId = Guid.Empty;

	public void Toggle()
	{
		IsOpen = !IsOpen;
		if ( IsOpen )
			CurrentTab = "feed";
	}

	// ═══════════════════════════════════════
	//  FEED TAB
	// ═══════════════════════════════════════

	private RenderFragment RenderFeed()
	{
		var twitter = GoblinTwitter.Instance;
		if ( twitter is null ) return null;

		return @<div class="feed">
			@foreach ( var post in twitter.Feed.Reverse() )
			{
				<div class="post @(post.IsNPC ? "npc-post" : "")">
					<div class="post-header">
						<span class="author">@@@post.AuthorName</span>
						@if ( post.TokenTicker is not null && post.TokenTicker.Length > 0 )
						{
							<span class="token-tag">$@post.TokenTicker</span>
						}
						<span class="shill-power">🔥 @post.ShillPower.ToString("F1")</span>
					</div>
					<div class="post-body">@post.Content</div>
					<div class="post-actions">
						<span class="action like" onclick="@(() => DoLike(post.PostId))">🔥 @post.Likes</span>
						<span class="action repost" onclick="@(() => DoRepost(post.PostId))">🔄 @post.Reposts</span>
						<span class="action fud" onclick="@(() => DoFud(post.PostId))">💀 @post.FudReplies</span>
						<span class="action report" onclick="@(() => DoReport(post.PostId))">🚨 @post.Reports</span>
					</div>
				</div>
			}
			@if ( twitter.Feed.Count == 0 )
			{
				<div class="empty-feed">No posts yet. Be the first to shill!</div>
			}
		</div>;
	}

	// ═══════════════════════════════════════
	//  TRENDING TAB
	// ═══════════════════════════════════════

	private RenderFragment RenderTrending()
	{
		var twitter = GoblinTwitter.Instance;
		if ( twitter is null ) return null;

		var trending = twitter.GetTrending();

		return @<div class="trending">
			<div class="trending-header">🔥 TRENDING ON GOBLINTWITTER</div>
			@{ int rank = 0; }
			@foreach ( var t in trending )
			{
				rank++;
				<div class="trending-item">
					<span class="rank">#@rank</span>
					<span class="ticker">$@t.Ticker</span>
					<span class="tname">@t.Name</span>
					<span class="tprice">@t.Price.ToString("F3") GBC</span>
					<span class="tscore">Score: @t.Score.ToString("F1")</span>
					<div class="trending-buy" onclick="@(() => QuickBuy(t.TokenId))">BUY 50 GBC</div>
				</div>
			}
			@if ( trending.Count == 0 )
			{
				<div class="empty-feed">Nothing trending. Start posting!</div>
			}
		</div>;
	}

	// ═══════════════════════════════════════
	//  COMPOSE TAB
	// ═══════════════════════════════════════

	private RenderFragment RenderComposer()
	{
		var tokenSys = TokenSystem.Instance;
		var tokens = tokenSys?.GetActiveTokensSorted() ?? new();

		float effectiveness = ShillTemplates.CalculateEffectiveness( _openerIdx, _claimIdx, _proofIdx, _ctaIdx, 1f );
		float risk = ShillTemplates.CalculateRisk( _openerIdx, _claimIdx, _proofIdx, _ctaIdx );

		return @<div class="composer">
			<div class="compose-header">COMPOSE SHILL</div>

			<!-- Token picker -->
			<div class="field">
				<label>SHILL WHICH TOKEN:</label>
				<div class="token-picker">
					@foreach ( var t in tokens )
					{
						var tid = t.Id;
						<div class="token-option @(_selectedTokenId == tid ? "selected" : "")"
							onclick="@(() => _selectedTokenId = tid)">
							$@t.Ticker (@t.Price.ToString("F3"))
						</div>
					}
				</div>
			</div>

			<!-- Opener -->
			<div class="field">
				<label>HYPE OPENER:</label>
				<div class="component-picker">
					@for ( int i = 0; i < ShillTemplates.HypeOpeners.Length; i++ )
					{
						var idx = i;
						var c = ShillTemplates.HypeOpeners[i];
						<div class="component @(_openerIdx == idx ? "selected" : "")"
							onclick="@(() => _openerIdx = idx)">
							@c.Text
						</div>
					}
				</div>
			</div>

			<!-- Claim -->
			<div class="field">
				<label>CLAIM:</label>
				<div class="component-picker">
					@for ( int i = 0; i < ShillTemplates.Claims.Length; i++ )
					{
						var idx = i;
						var c = ShillTemplates.Claims[i];
						<div class="component @(_claimIdx == idx ? "selected" : "")"
							onclick="@(() => _claimIdx = idx)">
							@c.Text
						</div>
					}
				</div>
			</div>

			<!-- Social Proof -->
			<div class="field">
				<label>SOCIAL PROOF:</label>
				<div class="component-picker">
					@for ( int i = 0; i < ShillTemplates.SocialProofs.Length; i++ )
					{
						var idx = i;
						var c = ShillTemplates.SocialProofs[i];
						<div class="component @(_proofIdx == idx ? "selected" : "")"
							onclick="@(() => _proofIdx = idx)">
							@c.Text
						</div>
					}
				</div>
			</div>

			<!-- CTA -->
			<div class="field">
				<label>CALL TO ACTION:</label>
				<div class="component-picker">
					@for ( int i = 0; i < ShillTemplates.CTAs.Length; i++ )
					{
						var idx = i;
						var c = ShillTemplates.CTAs[i];
						<div class="component @(_ctaIdx == idx ? "selected" : "")"
							onclick="@(() => _ctaIdx = idx)">
							@c.Text
						</div>
					}
				</div>
			</div>

			<!-- Custom text -->
			<div class="field">
				<label>PERSONAL TOUCH (80 chars):</label>
				<TextEntry @ref="CustomTextEntry" Text="@_customText" MaxLength=80
					class="custom-text" />
			</div>

			<!-- Stats preview -->
			<div class="stats-preview">
				<span class="stat power">SHILL POWER: @effectiveness.ToString("F1")</span>
				<span class="stat risk">SEC RISK: @risk.ToString("F1")</span>
			</div>

			<!-- Post button -->
			<div class="post-button @(_selectedTokenId == Guid.Empty ? "disabled" : "")"
				onclick="@DoPost">
				POST IT 📣
			</div>
		</div>;
	}

	private TextEntry CustomTextEntry;

	// ═══════════════════════════════════════
	//  PORTFOLIO TAB
	// ═══════════════════════════════════════

	private RenderFragment RenderPortfolio()
	{
		var localPlayer = GoblinPlayer.All.FirstOrDefault( p => !p.IsProxy );
		var wallet = localPlayer?.Components.Get<CryptoWallet>();
		var tokenSys = TokenSystem.Instance;

		if ( wallet is null || tokenSys is null )
			return @<div class="empty-feed">No wallet data</div>;

		float totalTokenValue = 0f;
		foreach ( var kv in wallet.TokenHoldings )
		{
			var tok = tokenSys.GetToken( kv.Key );
			if ( tok is not null ) totalTokenValue += kv.Value * tok.Value.Price;
		}
		float totalValue = wallet.GoblinCoin + totalTokenValue;

		return @<div class="portfolio">
			<div class="port-header">YOUR BAGS</div>

			<div class="port-summary">
				<div class="port-total">@totalValue.ToString("N1") <span class="port-unit">GBC total</span></div>
			</div>

			<div class="port-row port-gbc">
				<span class="port-symbol">GBC</span>
				<span class="port-name">GoblinCoin</span>
				<span class="port-val">@wallet.GoblinCoin.ToString("N1")</span>
			</div>

			@if ( wallet.TokenHoldings.Count == 0 )
			{
				<div class="empty-feed" style="padding: 20px;">No token holdings yet</div>
			}
			@foreach ( var kv in wallet.TokenHoldings )
			{
				var tok = tokenSys.GetToken( kv.Key );
				if ( tok is null ) continue;
				var t = tok.Value;
				float val = kv.Value * t.Price;
				string pct = totalValue > 0f ? $"{(val / totalValue * 100f):F0}%" : "0%";
				bool up = t.Price >= t.PreviousPrice;
				<div class="port-row">
					<span class="port-symbol">$@t.Ticker</span>
					<span class="port-name">@kv.Value.ToString("N0") units</span>
					<span class="port-val @(up ? "green" : "red")">@val.ToString("N1")</span>
					<span class="port-pct">@pct</span>
				</div>
			}
		</div>;
	}

	// ═══════════════════════════════════════
	//  MARKET MANIPULATION TAB
	// ═══════════════════════════════════════

	private Guid _shortTokenId = Guid.Empty;
	private float _shortAmount = 100f;

	private RenderFragment RenderMarket()
	{
		var manip = MarketManipulation.Instance;
		var tokenSys = TokenSystem.Instance;
		var localPlayer = GoblinPlayer.All.FirstOrDefault( p => !p.IsProxy );
		var wallet = localPlayer?.Components.Get<CryptoWallet>();

		if ( manip is null || tokenSys is null || wallet is null )
			return @<div class="empty-feed">Market data unavailable</div>;

		var tokens = tokenSys.ActiveTokens.Values
			.Where( t => !t.IsRugged )
			.OrderByDescending( t => t.Price )
			.ToList();

		return @<div class="market-panel">

			<!-- Wash Trading -->
			<div class="mkt-section">
				<div class="mkt-section-title">WASH TRADING <span class="mkt-cost">@manip.WashTradeCost.ToString("N0") GBC / action</span></div>
				<div class="mkt-desc">Fake volume. Boost your token's price. Very illegal. +SEC Heat.</div>
				@if ( tokens.Count == 0 )
				{
					<div class="mkt-empty">No active tokens</div>
				}
				@foreach ( var tok in tokens )
				{
					<div class="mkt-row">
						<span class="mkt-tok-name">$@tok.Ticker</span>
						<span class="mkt-tok-price">@tok.Price.ToString("F3")</span>
						<button class="mkt-btn" onclick="@(() => DoWashTrade(tok.Id))">WASH</button>
					</div>
				}
			</div>

			<!-- Pump Group -->
			<div class="mkt-section">
				<div class="mkt-section-title">PUMP GROUP <span class="mkt-cost">@manip.PumpGroupCost.ToString("N0") GBC</span></div>
				<div class="mkt-desc">Coordinate a pump. Others can join for half price.</div>
				@if ( manip.ActivePumpGroups > 0 && !string.IsNullOrEmpty(manip.LatestPumpId) )
				{
					<div class="mkt-pump-active">@manip.ActivePumpGroups active pump group(s)</div>
					<button class="mkt-btn join-pump" onclick="@DoJoinPump">JOIN PUMP (@((manip.PumpGroupCost * 0.5f).ToString("N0")) GBC)</button>
				}
				@foreach ( var tok in tokens.Take(3) )
				{
					<div class="mkt-row">
						<span class="mkt-tok-name">$@tok.Ticker</span>
						<button class="mkt-btn" onclick="@(() => DoPump(tok.Id))">START PUMP</button>
					</div>
				}
			</div>

			<!-- Short Selling -->
			<div class="mkt-section">
				<div class="mkt-section-title">SHORT SELL <span class="mkt-cost">@manip.ShortSellCost.ToString("N0") GBC</span></div>
				<div class="mkt-desc">Bet a token dumps. Profit = (entry - exit) × @manip.ShortSellLeverage.ToString("F0")x leverage.</div>
				@{ bool hasShort = localPlayer is not null && manip.PlayerShortIds.ContainsKey( localPlayer.Id ); }
				@if ( hasShort )
				{
					<div class="mkt-open-short">
						<span class="mkt-open-short-label">⚠ You have an open short position</span>
						<button class="mkt-btn close-short" onclick="@DoCloseShort">CLOSE SHORT</button>
					</div>
				}
				else if ( OfficeSetup.Instance?.OfficeEra >= 2 )
				{
					<div class="mkt-short-controls">
						<div class="mkt-row" style="flex-wrap:wrap; gap:4px;">
							@foreach ( var tok in tokens.Take(4) )
							{
								<button class="mkt-tok-chip @(_shortTokenId == tok.Id ? "selected" : "")"
										onclick="@(() => _shortTokenId = tok.Id)">$@tok.Ticker</button>
							}
						</div>
						<div class="mkt-amount-row">
							<button class="mkt-adj" onclick="@(() => _shortAmount = MathF.Max(10f, _shortAmount - 50f))">−</button>
							<span class="mkt-amount">@_shortAmount.ToString("N0") units</span>
							<button class="mkt-adj" onclick="@(() => _shortAmount += 50f)">+</button>
						</div>
						<button class="mkt-btn short-btn @(_shortTokenId == Guid.Empty ? "disabled" : "")"
								onclick="@DoShort">OPEN SHORT</button>
					</div>
				}
				else
				{
					<div class="mkt-empty">Unlocks at Exchange Era (Era 3)</div>
				}
			</div>

		</div>;
	}

	private void DoWashTrade( Guid tokenId )
	{
		MarketManipulation.Instance?.RequestWashTrade( tokenId );
	}

	private void DoPump( Guid tokenId )
	{
		MarketManipulation.Instance?.RequestStartPump( tokenId );
	}

	private void DoJoinPump()
	{
		var manip = MarketManipulation.Instance;
		if ( manip is null || string.IsNullOrEmpty( manip.LatestPumpId ) ) return;
		manip.RequestJoinPump( manip.LatestPumpId );
	}

	private void DoShort()
	{
		if ( _shortTokenId == Guid.Empty ) return;
		MarketManipulation.Instance?.RequestShortSell( _shortTokenId, _shortAmount );
		_shortTokenId = Guid.Empty;
	}

	private void DoCloseShort()
	{
		var manip = MarketManipulation.Instance;
		var localPlayer = GoblinPlayer.All.FirstOrDefault( p => !p.IsProxy );
		if ( manip is null || localPlayer is null ) return;
		if ( manip.PlayerShortIds.TryGetValue( localPlayer.Id, out var shortId ) )
			manip.RequestCloseShort( shortId );
	}

	// ═══════════════════════════════════════
	//  ACTIONS
	// ═══════════════════════════════════════

	private void DoPost()
	{
		if ( _selectedTokenId == Guid.Empty ) return;

		var twitter = GoblinTwitter.Instance;
		twitter?.RequestPost( _selectedTokenId, _openerIdx, _claimIdx, _proofIdx, _ctaIdx, _customText );

		// Reset and switch to feed
		_customText = "";
		CurrentTab = "feed";
	}

	private void DoLike( Guid postId )
	{
		GoblinTwitter.Instance?.RequestLike( postId );
	}

	private void DoRepost( Guid postId )
	{
		GoblinTwitter.Instance?.RequestRepost( postId );
	}

	private void DoFud( Guid postId )
	{
		GoblinTwitter.Instance?.RequestFud( postId );
	}

	private void DoReport( Guid postId )
	{
		GoblinTwitter.Instance?.RequestReport( postId );
	}

	private void QuickBuy( Guid tokenId )
	{
		TokenSystem.Instance?.RequestBuyToken( tokenId, 50f );
	}
}

<style>
	.phone-root {
		position: absolute;
		right: 20px;
		bottom: 20px;
		pointer-events: all;
	}
	.phone-root.closed { display: none; }

	.phone-frame {
		width: 380px;
		height: 620px;
		background-color: rgba(0, 10, 0, 0.95);
		border: 2px solid #00ff41;
		border-radius: 12px;
		display: flex;
		flex-direction: column;
		font-family: Consolas, monospace;
		color: #00ff41;
		overflow: hidden;
	}

	.phone-tabs {
		display: flex;
		border-bottom: 1px solid #00ff41;
	}
	.tab {
		flex: 1;
		text-align: center;
		padding: 8px;
		cursor: pointer;
		font-size: 12px;
		font-weight: bold;
	}
	.tab:hover { background-color: rgba(0, 255, 65, 0.1); }
	.tab.active { background-color: rgba(0, 255, 65, 0.2); border-bottom: 2px solid #00ff41; }

	.phone-content {
		flex: 1;
		overflow-y: auto;
		padding: 8px;
	}

	.phone-hint {
		text-align: center;
		padding: 4px;
		font-size: 10px;
		opacity: 0.5;
	}

	/* Feed */
	.post {
		border: 1px solid rgba(0, 255, 65, 0.3);
		border-radius: 6px;
		padding: 8px;
		margin-bottom: 6px;
	}
	.npc-post { border-color: rgba(100, 100, 100, 0.3); color: #888; }
	.post-header { display: flex; gap: 8px; font-size: 11px; margin-bottom: 4px; }
	.author { font-weight: bold; color: #00ff41; }
	.token-tag { color: #ffaa00; }
	.shill-power { margin-left: auto; color: #ff4444; }
	.post-body { font-size: 12px; margin-bottom: 6px; line-height: 1.3; }
	.post-actions { display: flex; gap: 12px; font-size: 11px; }
	.action { cursor: pointer; opacity: 0.7; }
	.action:hover { opacity: 1; }
	.empty-feed { text-align: center; opacity: 0.5; padding: 40px; }

	/* Trending */
	.trending-header { font-weight: bold; text-align: center; padding: 8px; font-size: 14px; }
	.trending-item {
		display: flex; flex-wrap: wrap; gap: 8px; align-items: center;
		padding: 8px; border: 1px solid rgba(0, 255, 65, 0.2); border-radius: 6px;
		margin-bottom: 6px;
	}
	.rank { font-weight: bold; font-size: 18px; color: #ffaa00; }
	.ticker { font-weight: bold; }
	.tprice { color: #ffaa00; margin-left: auto; }
	.trending-buy {
		width: 100%; text-align: center; padding: 4px;
		border: 1px solid #00ff41; border-radius: 4px;
		cursor: pointer; font-size: 11px;
	}
	.trending-buy:hover { background-color: rgba(0, 255, 65, 0.2); }

	/* Composer */
	.compose-header { font-weight: bold; text-align: center; padding: 8px; font-size: 14px; }
	.field { margin-bottom: 8px; }
	.field label { font-size: 10px; font-weight: bold; display: block; margin-bottom: 2px; opacity: 0.7; }

	.token-picker, .component-picker {
		display: flex; flex-wrap: wrap; gap: 4px;
	}
	.token-option, .component {
		padding: 4px 8px; border: 1px solid rgba(0, 255, 65, 0.3);
		border-radius: 4px; cursor: pointer; font-size: 10px;
	}
	.token-option:hover, .component:hover { background-color: rgba(0, 255, 65, 0.1); }
	.token-option.selected, .component.selected {
		background-color: rgba(0, 255, 65, 0.3); border-color: #00ff41;
	}

	.custom-text {
		width: 100%; background: rgba(0, 20, 0, 0.8); border: 1px solid #00ff41;
		color: #00ff41; padding: 6px; font-family: Consolas, monospace; font-size: 11px;
	}

	.stats-preview {
		display: flex; justify-content: space-between; padding: 6px;
		border: 1px solid rgba(0, 255, 65, 0.2); border-radius: 4px; font-size: 12px;
		margin-bottom: 8px;
	}
	.stat.power { color: #ff8800; }
	.stat.risk { color: #ff4444; }

	.post-button {
		text-align: center; padding: 10px; background-color: rgba(0, 255, 65, 0.2);
		border: 2px solid #00ff41; border-radius: 6px; cursor: pointer;
		font-weight: bold; font-size: 14px;
	}
	.post-button:hover { background-color: rgba(0, 255, 65, 0.4); }
	.post-button.disabled { opacity: 0.3; pointer-events: none; }

	/* Portfolio */
	.port-header { font-weight: bold; text-align: center; padding: 8px; font-size: 14px; }
	.port-summary { text-align: center; margin-bottom: 10px; }
	.port-total { font-size: 20px; font-weight: bold; color: #00ff41; }
	.port-unit { font-size: 11px; opacity: 0.6; }
	.port-row {
		display: flex; align-items: center; gap: 6px;
		padding: 6px 4px; border-bottom: 1px solid rgba(0,255,65,0.1);
		font-size: 12px;
	}
	.port-row.port-gbc { color: #ffcc00; }
	.port-symbol { font-weight: bold; min-width: 48px; }
	.port-name { flex: 1; opacity: 0.6; font-size: 10px; }
	.port-val { font-weight: bold; }
	.port-val.green { color: #00ff88; }
	.port-val.red { color: #ff4444; }
	.port-pct { font-size: 10px; opacity: 0.5; min-width: 32px; text-align: right; }

	/* Market / Degen tab */
	.market-panel { display: flex; flex-direction: column; gap: 10px; padding: 4px; }
	.mkt-section {
		background: rgba(255,68,68,0.04);
		border: 1px solid rgba(255,68,68,0.15);
		border-radius: 5px;
		padding: 8px 10px;
	}
	.mkt-section-title {
		font-size: 9px; letter-spacing: 2px; color: #ff4444;
		margin-bottom: 3px; display: flex; justify-content: space-between;
	}
