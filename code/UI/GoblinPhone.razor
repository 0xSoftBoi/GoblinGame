@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.Linq;

@namespace GoblinChain.UI
@inherits PanelComponent

<!--
	GoblinPhone — The in-game social media interface.
	Toggled by pressing T. Shows GoblinTwitter feed, trending tokens,
	and post composer. The soul of the game.
-->

<root class="phone-root @(IsOpen ? "open" : "closed")">

	@if ( IsOpen )
	{
		<div class="phone-frame">
			<!-- Tab bar -->
			<div class="phone-tabs">
				<div class="tab @(CurrentTab == "feed" ? "active" : "")" onclick="@(() => CurrentTab = "feed")">FEED</div>
				<div class="tab @(CurrentTab == "trending" ? "active" : "")" onclick="@(() => CurrentTab = "trending")">TRENDING</div>
				<div class="tab @(CurrentTab == "compose" ? "active" : "")" onclick="@(() => CurrentTab = "compose")">POST</div>
			</div>

			<!-- Content area -->
			<div class="phone-content">

				@if ( CurrentTab == "feed" )
				{
					@RenderFeed()
				}
				else if ( CurrentTab == "trending" )
				{
					@RenderTrending()
				}
				else if ( CurrentTab == "compose" )
				{
					@RenderComposer()
				}

			</div>

			<!-- Close hint -->
			<div class="phone-hint">Press T to close</div>
		</div>
	}

</root>

@code
{
	public bool IsOpen { get; set; } = false;
	public string CurrentTab { get; set; } = "feed";

	// Composer state
	private int _openerIdx = 0;
	private int _claimIdx = 0;
	private int _proofIdx = 0;
	private int _ctaIdx = 0;
	private string _customText = "";
	private Guid _selectedTokenId = Guid.Empty;

	public void Toggle()
	{
		IsOpen = !IsOpen;
		if ( IsOpen )
			CurrentTab = "feed";
	}

	// ═══════════════════════════════════════
	//  FEED TAB
	// ═══════════════════════════════════════

	private RenderFragment RenderFeed()
	{
		var twitter = GoblinTwitter.Instance;
		if ( twitter is null ) return null;

		return @<div class="feed">
			@foreach ( var post in twitter.Feed.Reverse() )
			{
				<div class="post @(post.IsNPC ? "npc-post" : "")">
					<div class="post-header">
						<span class="author">@@@post.AuthorName</span>
						@if ( post.TokenTicker is not null && post.TokenTicker.Length > 0 )
						{
							<span class="token-tag">$@post.TokenTicker</span>
						}
						<span class="shill-power">🔥 @post.ShillPower.ToString("F1")</span>
					</div>
					<div class="post-body">@post.Content</div>
					<div class="post-actions">
						<span class="action like" onclick="@(() => DoLike(post.PostId))">🔥 @post.Likes</span>
						<span class="action repost" onclick="@(() => DoRepost(post.PostId))">🔄 @post.Reposts</span>
						<span class="action fud" onclick="@(() => DoFud(post.PostId))">💀 @post.FudReplies</span>
						<span class="action report" onclick="@(() => DoReport(post.PostId))">🚨 @post.Reports</span>
					</div>
				</div>
			}
			@if ( twitter.Feed.Count == 0 )
			{
				<div class="empty-feed">No posts yet. Be the first to shill!</div>
			}
		</div>;
	}

	// ═══════════════════════════════════════
	//  TRENDING TAB
	// ═══════════════════════════════════════

	private RenderFragment RenderTrending()
	{
		var twitter = GoblinTwitter.Instance;
		if ( twitter is null ) return null;

		var trending = twitter.GetTrending();

		return @<div class="trending">
			<div class="trending-header">🔥 TRENDING ON GOBLINTWITTER</div>
			@{ int rank = 0; }
			@foreach ( var t in trending )
			{
				rank++;
				<div class="trending-item">
					<span class="rank">#@rank</span>
					<span class="ticker">$@t.Ticker</span>
					<span class="tname">@t.Name</span>
					<span class="tprice">@t.Price.ToString("F3") GBC</span>
					<span class="tscore">Score: @t.Score.ToString("F1")</span>
					<div class="trending-buy" onclick="@(() => QuickBuy(t.TokenId))">BUY 50 GBC</div>
				</div>
			}
			@if ( trending.Count == 0 )
			{
				<div class="empty-feed">Nothing trending. Start posting!</div>
			}
		</div>;
	}

	// ═══════════════════════════════════════
	//  COMPOSE TAB
	// ═══════════════════════════════════════

	private RenderFragment RenderComposer()
	{
		var tokenSys = TokenSystem.Instance;
		var tokens = tokenSys?.GetActiveTokensSorted() ?? new();

		float effectiveness = ShillTemplates.CalculateEffectiveness( _openerIdx, _claimIdx, _proofIdx, _ctaIdx, 1f );
		float risk = ShillTemplates.CalculateRisk( _openerIdx, _claimIdx, _proofIdx, _ctaIdx );

		return @<div class="composer">
			<div class="compose-header">COMPOSE SHILL</div>

			<!-- Token picker -->
			<div class="field">
				<label>SHILL WHICH TOKEN:</label>
				<div class="token-picker">
					@foreach ( var t in tokens )
					{
						var tid = t.Id;
						<div class="token-option @(_selectedTokenId == tid ? "selected" : "")"
							onclick="@(() => _selectedTokenId = tid)">
							$@t.Ticker (@t.Price.ToString("F3"))
						</div>
					}
				</div>
			</div>

			<!-- Opener -->
			<div class="field">
				<label>HYPE OPENER:</label>
				<div class="component-picker">
					@for ( int i = 0; i < ShillTemplates.HypeOpeners.Length; i++ )
					{
						var idx = i;
						var c = ShillTemplates.HypeOpeners[i];
						<div class="component @(_openerIdx == idx ? "selected" : "")"
							onclick="@(() => _openerIdx = idx)">
							@c.Text
						</div>
					}
				</div>
			</div>

			<!-- Claim -->
			<div class="field">
				<label>CLAIM:</label>
				<div class="component-picker">
					@for ( int i = 0; i < ShillTemplates.Claims.Length; i++ )
					{
						var idx = i;
						var c = ShillTemplates.Claims[i];
						<div class="component @(_claimIdx == idx ? "selected" : "")"
							onclick="@(() => _claimIdx = idx)">
							@c.Text
						</div>
					}
				</div>
			</div>

			<!-- Social Proof -->
			<div class="field">
				<label>SOCIAL PROOF:</label>
				<div class="component-picker">
					@for ( int i = 0; i < ShillTemplates.SocialProofs.Length; i++ )
					{
						var idx = i;
						var c = ShillTemplates.SocialProofs[i];
						<div class="component @(_proofIdx == idx ? "selected" : "")"
							onclick="@(() => _proofIdx = idx)">
							@c.Text
						</div>
					}
				</div>
			</div>

			<!-- CTA -->
			<div class="field">
				<label>CALL TO ACTION:</label>
				<div class="component-picker">
					@for ( int i = 0; i < ShillTemplates.CTAs.Length; i++ )
					{
						var idx = i;
						var c = ShillTemplates.CTAs[i];
						<div class="component @(_ctaIdx == idx ? "selected" : "")"
							onclick="@(() => _ctaIdx = idx)">
							@c.Text
						</div>
					}
				</div>
			</div>

			<!-- Custom text -->
			<div class="field">
				<label>PERSONAL TOUCH (80 chars):</label>
				<TextEntry @ref="CustomTextEntry" Text="@_customText" MaxLength=80
					class="custom-text" />
			</div>

			<!-- Stats preview -->
			<div class="stats-preview">
				<span class="stat power">SHILL POWER: @effectiveness.ToString("F1")</span>
				<span class="stat risk">SEC RISK: @risk.ToString("F1")</span>
			</div>

			<!-- Post button -->
			<div class="post-button @(_selectedTokenId == Guid.Empty ? "disabled" : "")"
				onclick="@DoPost">
				POST IT 📣
			</div>
		</div>;
	}

	private TextEntry CustomTextEntry;

	// ═══════════════════════════════════════
	//  ACTIONS
	// ═══════════════════════════════════════

	private void DoPost()
	{
		if ( _selectedTokenId == Guid.Empty ) return;

		var twitter = GoblinTwitter.Instance;
		twitter?.RequestPost( _selectedTokenId, _openerIdx, _claimIdx, _proofIdx, _ctaIdx, _customText );

		// Reset and switch to feed
		_customText = "";
		CurrentTab = "feed";
	}

	private void DoLike( Guid postId )
	{
		GoblinTwitter.Instance?.RequestLike( postId );
	}

	private void DoRepost( Guid postId )
	{
		GoblinTwitter.Instance?.RequestRepost( postId );
	}

	private void DoFud( Guid postId )
	{
		GoblinTwitter.Instance?.RequestFud( postId );
	}

	private void DoReport( Guid postId )
	{
		GoblinTwitter.Instance?.RequestReport( postId );
	}

	private void QuickBuy( Guid tokenId )
	{
		TokenSystem.Instance?.RequestBuyToken( tokenId, 50f );
	}
}

<style>
	.phone-root {
		position: absolute;
		right: 20px;
		bottom: 20px;
		pointer-events: all;
	}
	.phone-root.closed { display: none; }

	.phone-frame {
		width: 380px;
		height: 620px;
		background-color: rgba(0, 10, 0, 0.95);
		border: 2px solid #00ff41;
		border-radius: 12px;
		display: flex;
		flex-direction: column;
		font-family: Consolas, monospace;
		color: #00ff41;
		overflow: hidden;
	}

	.phone-tabs {
		display: flex;
		border-bottom: 1px solid #00ff41;
	}
	.tab {
		flex: 1;
		text-align: center;
		padding: 8px;
		cursor: pointer;
		font-size: 12px;
		font-weight: bold;
	}
	.tab:hover { background-color: rgba(0, 255, 65, 0.1); }
	.tab.active { background-color: rgba(0, 255, 65, 0.2); border-bottom: 2px solid #00ff41; }

	.phone-content {
		flex: 1;
		overflow-y: auto;
		padding: 8px;
	}

	.phone-hint {
		text-align: center;
		padding: 4px;
		font-size: 10px;
		opacity: 0.5;
	}

	/* Feed */
	.post {
		border: 1px solid rgba(0, 255, 65, 0.3);
		border-radius: 6px;
		padding: 8px;
		margin-bottom: 6px;
	}
	.npc-post { border-color: rgba(100, 100, 100, 0.3); color: #888; }
	.post-header { display: flex; gap: 8px; font-size: 11px; margin-bottom: 4px; }
	.author { font-weight: bold; color: #00ff41; }
	.token-tag { color: #ffaa00; }
	.shill-power { margin-left: auto; color: #ff4444; }
	.post-body { font-size: 12px; margin-bottom: 6px; line-height: 1.3; }
	.post-actions { display: flex; gap: 12px; font-size: 11px; }
	.action { cursor: pointer; opacity: 0.7; }
	.action:hover { opacity: 1; }
	.empty-feed { text-align: center; opacity: 0.5; padding: 40px; }

	/* Trending */
	.trending-header { font-weight: bold; text-align: center; padding: 8px; font-size: 14px; }
	.trending-item {
		display: flex; flex-wrap: wrap; gap: 8px; align-items: center;
		padding: 8px; border: 1px solid rgba(0, 255, 65, 0.2); border-radius: 6px;
		margin-bottom: 6px;
	}
	.rank { font-weight: bold; font-size: 18px; color: #ffaa00; }
	.ticker { font-weight: bold; }
	.tprice { color: #ffaa00; margin-left: auto; }
	.trending-buy {
		width: 100%; text-align: center; padding: 4px;
		border: 1px solid #00ff41; border-radius: 4px;
		cursor: pointer; font-size: 11px;
	}
	.trending-buy:hover { background-color: rgba(0, 255, 65, 0.2); }

	/* Composer */
	.compose-header { font-weight: bold; text-align: center; padding: 8px; font-size: 14px; }
	.field { margin-bottom: 8px; }
	.field label { font-size: 10px; font-weight: bold; display: block; margin-bottom: 2px; opacity: 0.7; }

	.token-picker, .component-picker {
		display: flex; flex-wrap: wrap; gap: 4px;
	}
	.token-option, .component {
		padding: 4px 8px; border: 1px solid rgba(0, 255, 65, 0.3);
		border-radius: 4px; cursor: pointer; font-size: 10px;
	}
	.token-option:hover, .component:hover { background-color: rgba(0, 255, 65, 0.1); }
	.token-option.selected, .component.selected {
		background-color: rgba(0, 255, 65, 0.3); border-color: #00ff41;
	}

	.custom-text {
		width: 100%; background: rgba(0, 20, 0, 0.8); border: 1px solid #00ff41;
		color: #00ff41; padding: 6px; font-family: Consolas, monospace; font-size: 11px;
	}

	.stats-preview {
		display: flex; justify-content: space-between; padding: 6px;
		border: 1px solid rgba(0, 255, 65, 0.2); border-radius: 4px; font-size: 12px;
		margin-bottom: 8px;
	}
	.stat.power { color: #ff8800; }
	.stat.risk { color: #ff4444; }

	.post-button {
		text-align: center; padding: 10px; background-color: rgba(0, 255, 65, 0.2);
		border: 2px solid #00ff41; border-radius: 6px; cursor: pointer;
		font-weight: bold; font-size: 14px;
	}
	.post-button:hover { background-color: rgba(0, 255, 65, 0.4); }
	.post-button.disabled { opacity: 0.3; pointer-events: none; }
</style>
