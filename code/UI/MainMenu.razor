@using Sandbox;
@using Sandbox.UI;

@namespace GoblinChain.UI
@inherits PanelComponent

<root class="main-menu">

	<!-- Background -->
	<div class="bg-gradient"></div>

	<!-- Logo -->
	<div class="logo-block">
		<div class="logo-main">GOBLIN CHAIN</div>
		<div class="logo-sub">Crypto Chaos Tycoon</div>
		<div class="logo-version">@GameVersion.Phase @GameVersion.Current</div>
	</div>

	<!-- Menu Buttons -->
	<div class="menu-stack">
		<button class="menu-btn primary" onclick="@HostGame">
			<span class="btn-icon">▶</span> HOST GAME
		</button>
		<button class="menu-btn" onclick="@JoinGame">
			<span class="btn-icon">◈</span> JOIN GAME
		</button>
		<button class="menu-btn" onclick="@ToggleSettings">
			<span class="btn-icon">⚙</span> SETTINGS
		</button>
	</div>

	<!-- Player Count -->
	<div class="online-count">
		<span class="dot"></span> @GameVersion.Name
	</div>

	<!-- Rotating Lore Tip -->
	<div class="tagline">
		@CurrentTip
	</div>

</root>

<style>
.main-menu {
	position: absolute;
	left: 0; top: 0; right: 0; bottom: 0;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	font-family: 'Consolas', 'Courier New', monospace;
	pointer-events: all;
}

.bg-gradient {
	position: absolute;
	left: 0; top: 0; right: 0; bottom: 0;
	background: linear-gradient(160deg, #050510 0%, #0a0a2e 40%, #0d0520 100%);
	z-index: -1;
}

/* ─── Logo ─── */

.logo-block {
	text-align: center;
	margin-bottom: 50px;
}

.logo-main {
	font-size: 80px;
	font-weight: bold;
	color: #00ff88;
	letter-spacing: 8px;
	text-shadow:
		0 0 40px rgba(0, 255, 136, 0.3),
		0 0 80px rgba(0, 255, 136, 0.1);
	line-height: 1;
}

.logo-sub {
	font-size: 20px;
	color: #555;
	letter-spacing: 6px;
	margin-top: 8px;
}

.logo-version {
	font-size: 11px;
	color: #333;
	letter-spacing: 3px;
	margin-top: 6px;
}

/* ─── Buttons ─── */

.menu-stack {
	display: flex;
	flex-direction: column;
	gap: 10px;
	min-width: 300px;
}

.menu-btn {
	padding: 16px 40px;
	font-size: 16px;
	font-weight: bold;
	letter-spacing: 3px;
	font-family: 'Consolas', monospace;
	background: rgba(255, 255, 255, 0.03);
	color: #888;
	border: 1px solid #333;
	border-radius: 4px;
	cursor: pointer;
	transition: all 0.15s ease;
	display: flex;
	align-items: center;
	gap: 12px;
}

.menu-btn:hover {
	background: rgba(0, 255, 136, 0.08);
	color: #00ff88;
	border-color: #00ff88;
}

.menu-btn.primary {
	color: #00ff88;
	border-color: #00ff88;
	background: rgba(0, 255, 136, 0.06);
}

.menu-btn.primary:hover {
	background: rgba(0, 255, 136, 0.2);
	text-shadow: 0 0 10px rgba(0, 255, 136, 0.4);
}

.btn-icon {
	font-size: 14px;
	opacity: 0.6;
}

/* ─── Footer ─── */

.online-count {
	position: absolute;
	bottom: 50px;
	font-size: 12px;
	color: #333;
	display: flex;
	align-items: center;
	gap: 8px;
}

.dot {
	width: 6px;
	height: 6px;
	border-radius: 50%;
	background: #00ff88;
}

.tagline {
	position: absolute;
	bottom: 24px;
	font-size: 13px;
	color: #222;
	letter-spacing: 2px;
}
</style>

@code
{
	public string CurrentTip { get; set; } = GameLore.GetRandomTip();
	private float _tipTimer = 0f;
	private float _tipInterval = 6f;

	protected override void OnUpdate()
	{
		_tipTimer += Time.Delta;
		if ( _tipTimer >= _tipInterval )
		{
			_tipTimer = 0f;
			CurrentTip = GameLore.GetRandomTip();
		}
	}

	void HostGame()
	{
		Log.Info( "Hosting game..." );
		Scene.LoadFromFile( "scenes/main.scene" );
	}

	void JoinGame()
	{
		Log.Info( "Opening lobby browser..." );
		// S&box lobby browser integration would go here
	}

	void ToggleSettings()
	{
		Log.Info( "Settings not yet implemented" );
	}
}
